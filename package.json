{
  "name": "tokentrim",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Offline-first PWA that compresses LLM prompts in the browser with LLMLingua-2.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "@atjsh/llmlingua-2": "3.0.0",
    "@huggingface/transformers": "4.3.2",
    "js-tiktoken": "1.0.21"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
